{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PF arm output (proofs, checkable)",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "evidence", "confidence"],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "description": "The complete Lean 4 source file: starts with `import Mathlib` and proves a top-level theorem with the item's exact name and statement; no sorry/admit/axiom/native_decide."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "detail"],
        "properties": {
          "kind": {"enum": ["command", "file_line", "quote", "counterexample", "test"]},
          "ref": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
