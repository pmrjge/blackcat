{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "answer",
  "evidence",
  "confidence"
 ],
 "properties": {
  "answer": {
   "type": "number"
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "kind",
     "ref",
     "detail"
    ],
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "command",
       "file_line",
       "quote",
       "counterexample",
       "test"
      ]
     },
     "ref": {
      "type": "string"
     },
     "detail": {
      "type": "string"
     }
    }
   }
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  }
 }
}
