#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""EQ_STUB_CLAUDE: a fake `claude` for the harness tests and the zero-spend dry run (PLAN step 3).

Put a symlink named `claude` to this file first on PATH. It never contacts any API. It reads the prompt on stdin
(first line `<ITEM> <label> <role>`), and prints a `--output-format json` envelope with a schema-valid
`structured_output`, a fake `total_cost_usd` (<= the --max-budget-usd cap) and fake `usage`.

Env:
  EQ_STUB_SCRIPT  JSON file {"<key>": {"structured_output": {...}, "cost": 0.01, "subtype": "...", "exit": 0}}
                  keys tried in order: "<ITEM>|<label>|<role>", "<ITEM>|<label>|<orig role>><role>" (resumed calls),
                  "<ITEM>|<role>", "<ITEM>|*", "*". Without a hit the answer is generated from --json-schema.
                  An entry may also hold "write": {"<relative path>": "<text>"}: files written into the cwd (a member
                  editing its working copy; paths are relative, never absolute, never `..`).
  EQ_STUB_LOG     JSONL file: one line per invocation (argv, cwd, head, session_id, parent_session_id).
  EQ_STUB_STATE   directory for session state (default: $TMPDIR/eq_stub_state): one `<session id>.json` per session
                  {"role", "head", "parent", "cwd", "turns": [head, ...]}, the session's turn log.

Sessions (COMPARE_eq §12 A6.1, E2): a new call gets a session id (`--session-id S` if given: S, refused when S already
exists; else a uuid5 of head and cwd). `--resume X` continues X in place (its turn log grows); `--resume X
--fork-session` copies X's turn log into a NEW session id (uuid4) and leaves X untouched; resuming an unknown session
fails (exit 1, as claude does). The envelope carries `modelUsage` keyed by the concrete model id (`--model` alias
opus/sonnet -> claude-<alias>-stub; a full id is kept), as claude -p does.
"""

from __future__ import annotations

import hashlib
import json
import os
import sys
import uuid
from pathlib import Path
from typing import Any

MODEL = "claude-sonnet-stub"  # never a haiku id (user constraint 2026-10-04)


def model_id(alias: str | None) -> str:
    """The concrete id a `--model` value runs on (an alias -> the stub id of that family; a full id as given)."""
    if not alias:
        return MODEL
    return f"claude-{alias}-stub" if alias in ("opus", "sonnet") else alias


def opt(argv: list[str], name: str) -> str | None:
    if name in argv:
        i = argv.index(name)
        if i + 1 < len(argv):
            return argv[i + 1]
    return None


def h(text: str) -> int:
    return int(hashlib.sha256(text.encode()).hexdigest()[:8], 16)


def instance(schema: dict[str, Any], seed: int, path: str = "") -> Any:
    """A minimal valid instance of a JSON Schema subset (object, array, string, number, integer, boolean, enum)."""
    if "const" in schema:
        return schema["const"]
    if "enum" in schema:
        return schema["enum"][seed % len(schema["enum"])]
    for key in ("oneOf", "anyOf"):
        if key in schema:
            return instance(schema[key][0], seed, path)
    t = schema.get("type", "object")
    if isinstance(t, list):
        t = next((x for x in t if x != "null"), "null")
    if t == "object":
        props = schema.get("properties", {})
        req = schema.get("required", list(props))
        return {k: instance(props.get(k, {"type": "string"}), seed + i, f"{path}.{k}") for i, k in enumerate(req)}
    if t == "array":
        k = max(int(schema.get("minItems", 0)), 1 if schema.get("items") else 0)
        return [instance(schema.get("items", {"type": "string"}), seed + j, f"{path}[{j}]") for j in range(k)]
    if t == "string":
        s = ["alpha", "beta"][seed % 2]
        return s + "x" * max(0, int(schema.get("minLength", 0)) - len(s))
    if t == "integer":
        return max(int(schema.get("minimum", 0)), 1 + seed % 3)
    if t == "number":
        lo = float(schema.get("minimum", 0.0))
        hi = float(schema.get("maximum", 1e9))
        if path.endswith("confidence"):
            return 0.5
        return min(max(100.0 * (1 + seed % 3), lo), hi)
    if t == "boolean":
        return bool(seed % 2)
    return None


def special(role: str, schema: dict[str, Any], prompt: str, seed: int) -> dict[str, Any] | None:
    props = schema.get("properties", {})
    if "nodes" in props:  # a planner call
        kind = "other"
        for ln in prompt.splitlines():
            if ln.startswith("answer_kind: "):
                kind = {"checkable": "checkable", "finding_set": "finding-set", "numeric": "numeric",
                        "long_form": "long-form"}.get(ln.split(": ", 1)[1].strip(), "other")
        return {"nodes": [
            {"id": "a", "owner": "coder", "brief": "gather", "deps": [], "kind": "other", "weight": 1},
            {"id": "b", "owner": "verifier", "brief": "answer", "deps": ["a"], "kind": kind, "weight": 2 + seed % 2},
        ]}
    ans = props.get("answer", {})
    if "ranking" in ans.get("properties", {}):
        n = 0
        for ln in prompt.splitlines():
            if ln.startswith("CANDIDATES "):
                n = int(ln.split()[1])
        return {"answer": {"ranking": list(range(n))}, "evidence": [], "confidence": 0.5}
    return None


def fail(msg: str, sid: str | None = None) -> int:
    print(json.dumps({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": msg,
                      "session_id": sid}))
    return 1


def safe_rel(rel: str) -> Path | None:
    p = Path(rel)
    return None if p.is_absolute() or ".." in p.parts or not p.parts else p


def main() -> int:
    argv = sys.argv[1:]
    if "--version" in argv:
        print("0.0.0-stub (Claude Code) EQ_STUB_CLAUDE")
        return 0
    prompt = sys.stdin.read()
    head = prompt.splitlines()[0] if prompt else ""
    parts = head.split()
    item, label, role = [*parts, "?", "?", "?"][:3]
    schema = json.loads(opt(argv, "--json-schema") or "{}")
    cap = float(opt(argv, "--max-budget-usd") or "0")
    model = model_id(opt(argv, "--model"))
    state = Path(os.environ.get("EQ_STUB_STATE", os.path.join(os.environ.get("TMPDIR", "."), "eq_stub_state")))
    state.mkdir(parents=True, exist_ok=True)
    resume = opt(argv, "--resume")
    fork = "--fork-session" in argv
    want = opt(argv, "--session-id")
    orig_role = None
    parent = None
    turns: list[str] = []
    if fork and not resume:
        return fail("--fork-session needs --resume")
    if resume:
        f = state / f"{resume}.json"
        if not f.exists():
            return fail(f"No conversation found with session ID: {resume}")
        prev = json.loads(f.read_text())
        orig_role = prev["role"]
        turns = list(prev.get("turns", []))
        if fork:
            parent = resume
            sid = want or str(uuid.uuid4())
        else:
            sid = resume
    else:
        sid = want or str(uuid.uuid5(uuid.NAMESPACE_URL, f"{head}|{os.getcwd()}"))
        if want and (state / f"{sid}.json").exists():
            return fail(f"Session ID {sid} is already in use.")
    rec = {"role": orig_role or role, "head": head, "parent": parent, "cwd": os.getcwd(), "turns": [*turns, head]}
    (state / f"{sid}.json").write_text(json.dumps(rec))
    script: dict[str, Any] = {}
    if os.environ.get("EQ_STUB_SCRIPT"):
        script = json.loads(Path(os.environ["EQ_STUB_SCRIPT"]).read_text())
    keys = [f"{item}|{label}|{role}"]
    if orig_role:
        keys.append(f"{item}|{label}|{orig_role}>{role}")
    keys += [f"{item}|{role}", f"{item}|*", "*"]
    entry = next((script[k] for k in keys if k in script), {})
    for rel, text in (entry.get("write") or {}).items():
        p = safe_rel(rel)
        if p is None:
            return fail(f"refusing to write {rel!r}", sid)
        (Path.cwd() / p).parent.mkdir(parents=True, exist_ok=True)
        (Path.cwd() / p).write_text(str(text))
    seed = h(head + "|" + (orig_role or ""))
    so = entry.get("structured_output")
    if so is None:
        so = special(role, schema, prompt, seed) or instance(schema, seed)
    cost = float(entry.get("cost", min(cap, 0.001 + (seed % 100) / 10000.0)))
    usage = {"input_tokens": 100 + seed % 50, "cache_creation_input_tokens": 10, "cache_read_input_tokens": 20,
             "output_tokens": 30 + seed % 7}
    out = {
        "type": "result", "subtype": entry.get("subtype", "success"), "is_error": False, "duration_ms": 5,
        "num_turns": 1, "result": json.dumps(so), "structured_output": so, "session_id": sid,
        "total_cost_usd": cost, "model": model, "usage": usage,
        "modelUsage": {model: {"inputTokens": usage["input_tokens"], "outputTokens": usage["output_tokens"],
                               "cacheReadInputTokens": usage["cache_read_input_tokens"],
                               "cacheCreationInputTokens": usage["cache_creation_input_tokens"], "costUSD": cost}},
    }
    if os.environ.get("EQ_STUB_LOG"):
        with open(os.environ["EQ_STUB_LOG"], "a") as f:
            f.write(json.dumps({"argv": argv, "cwd": os.getcwd(), "head": head, "session_id": sid,
                                "parent_session_id": parent, "stdin_first_line": head}) + "\n")
    print(json.dumps(out))
    return int(entry.get("exit", 0))


if __name__ == "__main__":
    sys.exit(main())
