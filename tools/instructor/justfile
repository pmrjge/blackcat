# Deterministic instructor: a closed menu of fixed procedures. Dispatcher only: each recipe runs one
# script in bin/ with the caller's arguments as "$@" (positional, never interpolated into shell text);
# the argument allowlist, the plan, the detail log and the status line live in the scripts.
#
# Menu:    just -f tools/instructor/justfile --list
# Run:     just -f tools/instructor/justfile <recipe> [--dry-run] [args]   (args: <recipe> --help)
# Output:  one stdout line `OK|FAIL|NOOP <verb> key=value... log=<path>`; exit 0 OK, 1 FAIL,
#          2 bad argument, 3 NOOP; details in <checkout>/.claude-work/instr/.
# Rules:   no backticks, no {{arg}} interpolation, no variables (`just --set` could change one), no
#          recipe dependencies (tests/test_instr_safety.py).

set positional-arguments
set dotenv-load := false
set shell := ["/bin/sh", "-cu"]

# List the recipes (the default when no recipe is named)
[no-cd]
_menu:
    @just --justfile {{quote(justfile())}} --list

# The C10 check suite in a checkout: bash -n, guard self-test, lint_agents, prompt_budget, pytest, install_smoke
[no-cd]
check-suite *args:
    @uv run --quiet --script {{quote(justfile_directory() / "bin" / "check_suite.py")}} "$@"

# Fast-forward local main to a branch (flock + update-ref compare-and-swap), then C10 on main
[no-cd]
ff-merge *args:
    @uv run --quiet --script {{quote(justfile_directory() / "bin" / "ff_merge.py")}} "$@"

# Report worktrees and branches against main: dirty, busy, merged, prunable (changes nothing)
[no-cd]
worktree-audit *args:
    @uv run --quiet --script {{quote(justfile_directory() / "bin" / "worktree_audit.py")}} "$@"
