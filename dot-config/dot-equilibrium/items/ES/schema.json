{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ES arm output (estimation, numeric)",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "evidence", "confidence"],
  "properties": {
    "answer": {
      "type": "number",
      "description": "One positive point estimate in the unit named in the prompt (plain number, no range)."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "detail"],
        "properties": {
          "kind": {"enum": ["command", "file_line", "quote", "counterexample", "test"]},
          "ref": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
