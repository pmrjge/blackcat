{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eq RS arm output",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "evidence", "confidence"],
  "properties": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "rationale"],
      "properties": {
        "label": {"type": "string", "enum": ["SUPPORTED", "REFUTED", "NOT_IN_CORPUS"]},
        "value": {"type": "string", "maxLength": 200, "description": "REFUTED: the correct value stated by the deciding record; otherwise empty"},
        "rationale": {"type": "string", "maxLength": 1200, "description": "at most three sentences naming the deciding record"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "detail"],
        "properties": {
          "kind": {"type": "string", "enum": ["command", "file_line", "quote", "counterexample", "test"]},
          "ref": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
