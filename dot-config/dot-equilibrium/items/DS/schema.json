{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eq DS arm output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "evidence",
    "confidence"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "description": "the whole design as Markdown, at most 900 words"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "detail"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "command",
              "file_line",
              "quote",
              "counterexample",
              "test"
            ]
          },
          "ref": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
