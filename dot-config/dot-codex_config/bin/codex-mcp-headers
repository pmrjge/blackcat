#!/usr/bin/env python3
"""http_headers_helper for the `codex` profile's remote MCP servers (exa, jina, huggingface, wandb).

Installed as <CODEX_HOME>/stack/bin/codex-mcp-headers; the profile sets, per server,
    http_headers_helper = "<CODEX_HOME>/stack/bin/codex-mcp-headers <id>"
Adapted from dot-config/dot-claude/bin/mcp-headers (the Claude Code headersHelper). Stdlib only, Python >= 3.9.

    codex-mcp-headers [--env-file PATH] [--redact] <server-id>

Prints one JSON object {header: value} holding only the header of <server-id>: never another key of
the file. The key comes from stack.env (--env-file, else $STACK_ENV_FILE, else ../../stack.env next to
this script, i.e. <CODEX_HOME>/stack.env), then the process environment; for huggingface also the
`hf auth login` token file ($HF_TOKEN_PATH, $HF_HOME/token, $XDG_CACHE_HOME/huggingface/token,
~/.cache/huggingface/token), as the original does. No key -> {} (the server runs anonymously, or
fails to authenticate). An unknown <server-id> exits 2.

Fails closed (stderr reason, exit 1, nothing on stdout) when stack.env is not a regular file, not
owned by the caller, or readable or writable by group or others (chmod 600 fixes it), or not UTF-8:
a key file anyone else can edit could steer the headers. A symlinked stack.env (a dotfiles link: the
installer writes stack.env through links, WRITE_THROUGH) is followed, and the file it resolves to
must pass the same checks (they run on the opened descriptor, so they hold for the bytes read); a
dangling link is refused. The original reads it without these checks. A missing stack.env is no
error (no keys).

Unlike the original, a server id on the command line is NOT redacted: that is how Codex invokes the
helper. Pass --redact to look at the output by hand without exposing the key.

UNVERIFIED: the output format Codex expects from `http_headers_helper` (the vendored
config.schema.json types it as a string only; neither the docs nor the source read for DESIGN.md say
whether the command is run through a shell, which argv it gets, or whether it must print a JSON object
like Claude Code's headersHelper). This prints Claude Code's format. Probe line for probes/:
  P6b: profile `[mcp_servers.exa] url = "...", http_headers_helper = "<stack>/bin/codex-mcp-headers exa"`
       with EXA_API_KEY in stack.env; `codex --profile codex` lists exa's tools and a call succeeds ->
       Codex accepts a JSON object on stdout; a 401 or a helper error -> the format differs.

Seeded-bug proofs (tests/mutations/codex_mcp_headers.json; each turns tests/test_convert_agents.py
red): print every key of stack.env instead of the one header; read a group/other-readable file;
read a symlink's group-readable target; treat a dangling link as no file; read a symlink to a
directory.
"""
import errno
import json
import os
import re
import stat
import sys

# server id -> (header, variable, value format)
HEADERS = {
    "exa": ("x-api-key", "EXA_API_KEY", "{}"),
    "jina": ("Authorization", "JINA_API_KEY", "Bearer {}"),
    "huggingface": ("Authorization", "HF_TOKEN", "Bearer {}"),
    "wandb": ("Authorization", "WANDB_API_KEY", "Bearer {}"),
}
KEY_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
VALUE_RE = re.compile(r"[\x21-\x7e]+")  # printable ASCII, no spaces, quotes stripped below


class Refused(Exception):
    """stack.env cannot be trusted: print nothing, exit 1."""


def default_env_file():
    here = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(os.path.dirname(os.path.dirname(here)), "stack.env")


def _open_link(path):
    """An fd on the file a symlinked stack.env resolves to (the checks then run on that fd, so they
    hold for the bytes read). A dangling link or an unreadable target is refused."""
    try:
        return os.open(path, os.O_RDONLY | getattr(os, "O_NONBLOCK", 0))
    except FileNotFoundError:
        raise Refused("%s is a dangling symlink" % path)
    except OSError as exc:
        raise Refused("%s (a symlink): %s" % (path, exc.strerror))


def read_text_checked(path):
    """stack.env's text, or None when it does not exist. A symlink (a dotfiles link: stack.env is
    WRITE_THROUGH) is followed and its target checked like the file itself. Raises Refused on a
    dangling link, a non-regular file, another owner, a group/other mode bit, or text that is not
    UTF-8."""
    what = path
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0))
    except FileNotFoundError:
        return None
    except OSError as exc:
        if exc.errno == errno.ELOOP or os.path.islink(path):
            fd = _open_link(path)
            what = "%s (a symlink to %s)" % (path, os.path.realpath(path))
        else:
            raise Refused("%s: %s" % (path, exc.strerror))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Refused("%s is not a regular file" % what)
        if st.st_uid != os.getuid():
            raise Refused("%s is not owned by you" % what)
        if st.st_mode & 0o077:
            raise Refused("%s has mode %04o; run: chmod 600 %s" % (what, stat.S_IMODE(st.st_mode),
                                                                   os.path.realpath(path)))
        chunks = []
        while True:
            b = os.read(fd, 65536)
            if not b:
                break
            chunks.append(b)
    finally:
        os.close(fd)
    try:
        return b"".join(chunks).decode("utf-8")
    except UnicodeDecodeError:
        raise Refused("%s is not UTF-8" % path)


def parse_env(text):
    values = {}
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        if re.match(r"export\s", s):
            s = s[len("export"):].lstrip()
        key, sep, value = s.partition("=")
        key = key.strip()
        if not sep or not KEY_RE.fullmatch(key):
            continue
        value = value.strip()
        if value[:1] in ("'", '"') and value[0] in value[1:]:
            value = value[1:value.index(value[0], 1)]
        else:
            value = re.split(r"\s+#", value, maxsplit=1)[0].strip()
        values[key] = value
    return values


def hf_token_file():
    explicit = os.environ.get("HF_TOKEN_PATH")
    home = os.environ.get("HF_HOME")
    xdg = os.environ.get("XDG_CACHE_HOME")
    if explicit:
        path = os.path.expanduser(explicit)
    elif home:
        path = os.path.join(os.path.expanduser(home), "token")
    elif xdg:
        path = os.path.join(os.path.expanduser(xdg), "huggingface", "token")
    else:
        path = os.path.expanduser("~/.cache/huggingface/token")
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except (OSError, UnicodeDecodeError):
        return ""


def lookup(var, name, values):
    value = values.get(var, "") or os.environ.get(var, "")
    if not value and name == "huggingface":
        value = hf_token_file()
    value = value.strip()
    if not value or "$" in value or not VALUE_RE.fullmatch(value):
        return ""
    return value


def redact(value):
    prefix, _, secret = value.rpartition(" ")
    prefix = prefix + " " if prefix else ""
    return "%s<redacted:%d chars>" % (prefix, len(secret))


def usage(msg):
    sys.stderr.write("codex-mcp-headers: %s\nusage: codex-mcp-headers [--env-file PATH] [--redact] "
                     "<%s>\n" % (msg, "|".join(sorted(HEADERS))))
    return 2


def main(argv):
    args, env_file, redacted = list(argv[1:]), None, False
    while args and args[0].startswith("--"):
        opt = args.pop(0)
        if opt == "--redact":
            redacted = True
        elif opt == "--env-file" and args:
            env_file = args.pop(0)
        else:
            return usage("unknown option %s" % opt)
    if len(args) != 1:
        return usage("one server id expected")
    name = args[0].strip()
    spec = HEADERS.get(name)
    if spec is None:
        return usage("no headers known for server %r" % name[:40])
    path = env_file or os.environ.get("STACK_ENV_FILE") or default_env_file()
    try:
        text = read_text_checked(os.path.expanduser(path))
    except Refused as exc:
        sys.stderr.write("codex-mcp-headers: %s\n" % exc)
        return 1
    values = parse_env(text) if text is not None else {}
    header, var, fmt = spec
    headers = {}
    value = lookup(var, name, values)
    if value:
        headers[header] = fmt.format(value)
    if redacted:
        headers = {k: redact(v) for k, v in headers.items()}
    sys.stdout.write(json.dumps(headers))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
