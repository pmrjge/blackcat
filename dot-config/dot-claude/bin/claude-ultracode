#!/bin/sh
# claude-agent-stack: ninja-coder (or any agent) as the MAIN THREAD at ultracode — xhigh effort plus
# dynamic workflows, with workflow launches pre-approved in these sessions only.
#   claude-ninja [claude args…]     claude-ultracode <agent> [claude args…]
# Ultracode exists only on a main thread. An agent file's `effort` applies to subagents only, and
# `effort: ultracode` there is ignored (the agent would run at the calling session's level), so
# dispatched by BlackCat ninja-coder runs at max; started from here they run at ultracode.
case "$(basename "$0")" in
  claude-ninja) agent=ninja-coder ;;
  # retired 2026-10-04: an old link must not fall through and take its first argument as the agent
  claude-supreme)
    echo "claude-supreme is retired: ninja-coder is the top tier (claude-ninja). rm ~/.local/bin/claude-supreme" >&2
    exit 2 ;;
  *)
    if [ $# -eq 0 ]; then
      echo "usage: claude-ultracode <agent> [claude args…]   (or: claude-ninja)" >&2
      exit 2
    fi
    agent=$1
    shift ;;
esac
# The session starts in Plan, the stack's default. These agents' files carry `permissionMode:
# acceptEdits` for their runs as subagents; whether Claude Code applies that line to a main-thread
# agent is not documented, so the mode is passed explicitly (the CLI flag beats the settings file;
# that it also beats the agent file is expected, not verified: CONFIG.md, "Permission modes", has
# the probe). A mode you pass yourself wins: --permission-mode or --dangerously-skip-permissions.
own_mode=0
for a in "$@"; do
  case $a in
    --) break ;;
    --permission-mode|--permission-mode=*|--dangerously-skip-permissions) own_mode=1; break ;;
  esac
done
[ "$own_mode" = 1 ] || set -- --permission-mode plan "$@"
# Forge tokens stay out of the session (C6): agents never push or write to a forge, and a token in
# the environment would reach every subprocess an agent starts. gh's own login (gh auth) still
# answers reads.
exec env -u GITHUB_TOKEN -u GH_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN \
  -u GITLAB_TOKEN -u GITEA_TOKEN -u FORGEJO_TOKEN -u CODEBERG_TOKEN \
  claude --agent "$agent" --effort ultracode --settings '{"permissions":{"allow":["Workflow"]}}' "$@"
