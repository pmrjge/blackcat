# Dockerfile.minimal: the equilibrium check images, FROM Google's distroless cc image pinned by digest (USER decision
# 2026-10-06, DESIGN_DISTROLESS.md). No final image carries a distribution's shell, coreutils, interpreter, compiler or package
# manager; no stage runs apt, dpkg or reads snapshot.debian.org. Targets (build.sh --profiles core | --set min):
#   eq-min        PF and CP/CR: Lean 4.34.1 + Mathlib module files + CPython 3.14.8 (glibc) + uv + the /opt/eq/bin toolbox
#   eq-py-min     CP/CR: CPython + uv + the toolbox (no perl shim, no lake shim)
#   eq-lean-min   PF checks only (no Python: unusable for the PF oracle; profile candidates)
#   check-<target>  FROM the target: minimal/check.sh in the REAL final filesystem as user 10001 (build.sh builds it first)
#   bash-report   build.sh --resolve-tools: prints the GPG-verified bash pins (never part of an image)
# Toolbox /opt/eq/bin: static busybox (docker-library, sha256-pinned) + its applet links, static GNU bash 5.3.20 built here
# from the GPG-signed source (tc/build-bash.sh, output pinned), the perl shim (check_lean.sh's timeout wrapper only), the lake
# shim, static jq 1.8.2. /usr/bin/sh and /usr/bin/bash are links to /opt/eq/bin/bash (the harness's `/bin/sh -c` copy-in
# prefix and the shims' #!/bin/bash lines go through the base's usr-merged /bin). PATH holds /opt only.
# Every FROM is a global ARG below, pinned by digest (or scratch); the values are ./PINS's, and build.sh refuses a build when
# a value differs, is malformed (exit 2) or is a placeholder (exit 13). Every download is sha256-checked BEFORE it is
# unpacked; curl refuses http and non-https redirects. Final stages hold one COPY of the assembled layer and no RUN.
# Every RUN starts its script through `bash` or `sh`, so the files need no execute bit in the checkout.

ARG BUILDER_IMAGE=buildpack-deps:trixie@sha256:47fa3fd7df8022082e3f885881775cc7927ec210b470cc4eae9e874f871b008a
ARG MUSL_BUILDER_IMAGE=alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
ARG DISTROLESS_CC=gcr.io/distroless/cc-debian13@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2
ARG DISTROLESS_CC_ARM64=sha256:2f0295ce228a23109ec1c8d38763bfe995b0dba7b3672f58d3a67ebfbc542fdc
ARG LEAN_VERSION=4.34.1
ARG LEAN_SHA256=fdb974c2cdb4627e090d5d4007b913e09d13c4868720fb5594e22808b3de9e37
ARG UV_VERSION=0.12.22
ARG UV_SHA256=228bd32c180421a94eef91378a92b2dd63c768bd278430e833250524c4a13382
ARG PYTHON_VERSION=3.14.8
ARG PBS_TAG=20261001
ARG PYTHON_SHA256=4395ae16388f9d3409cba7e20161753ed3359b13d959345415029f874f675162
ARG MATHLIB_REV=d13f23b723b8a846827a245b89c10fc7d3f11612
ARG BUSYBOX_ROOTFS_URL=https://raw.githubusercontent.com/docker-library/busybox/b6edf7d5c5200d629d7c3f7758293a3675471dde/latest/musl/arm64v8/rootfs.tar.gz
ARG BUSYBOX_ROOTFS_SHA256=7e75e6d7d7c97e99528d165ddae068049dfd29846f693e5b35feba66c0e78912
ARG BUSYBOX_SHA256=4ab4ce065532286051cf7f3ca9d142a115b98da96016fb8be378008fedd70bda
ARG JQ_VERSION=1.8.2
ARG JQ_SHA256=8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309
ARG BASH_BASELINE=5.3
ARG BASH_PATCHLEVEL=20
ARG BASH_GPG_FPR=7C0135FB088AAF6C66C650B9BB5869F064EA74AB
ARG BASH_SRC_SHA256=0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba
ARG BASH_PATCHES_SHA256=51df03a9d332cc2a069701a0c786b01632b1726a106a1af7a13cf6210c205e64
ARG BASH_BIN_SHA256=e91998f0a96f92fa95ab42bf6d3b3f71c58b1b2f2e67a87d9e0ef0836d015bef

# ---------------------------------------------------------------- the final base, also read by the assemble stages
FROM ${DISTROLESS_CC} AS distroless-cc

# ---------------------------------------------------------------- fetch: pinned upstream binaries, sha256 checked first
FROM ${BUILDER_IMAGE} AS fetch
ARG LEAN_VERSION
ARG LEAN_SHA256
ARG UV_VERSION
ARG UV_SHA256
ARG PYTHON_VERSION
ARG PBS_TAG
ARG PYTHON_SHA256
ARG BUSYBOX_ROOTFS_URL
ARG BUSYBOX_ROOTFS_SHA256
ARG BUSYBOX_SHA256
ARG JQ_VERSION
ARG JQ_SHA256
COPY minimal/untar.py /opt/eq-fetch/untar.py
WORKDIR /tmp/dl
RUN set -eux; \
    get() { curl --proto '=https' --proto-redir '=https' --tlsv1.2 -fsSL --retry 5 -o "$1" "$2"; }; \
    get py.tar.gz "https://github.com/astral-sh/python-build-standalone/releases/download/${PBS_TAG}/cpython-${PYTHON_VERSION}%2B${PBS_TAG}-aarch64-unknown-linux-gnu-install_only_stripped.tar.gz"; \
    echo "${PYTHON_SHA256}  py.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/python; tar -xzf py.tar.gz -C /opt/python --strip-components=1 --no-same-owner; \
    [ -e /opt/python/bin/python ] || ln -s python3 /opt/python/bin/python; \
    /opt/python/bin/python3 --version | grep -F "${PYTHON_VERSION}"; \
    get lean.tar.zst "https://github.com/leanprover/lean4/releases/download/v${LEAN_VERSION}/lean-${LEAN_VERSION}-linux_aarch64.tar.zst"; \
    echo "${LEAN_SHA256}  lean.tar.zst" | sha256sum -c -; \
    mkdir -p /opt/lean; /opt/python/bin/python3 -I /opt/eq-fetch/untar.py lean.tar.zst /opt/lean; \
    /opt/lean/bin/lean --version | grep -F "version ${LEAN_VERSION}"; \
    get uv.tar.gz "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-aarch64-unknown-linux-musl.tar.gz"; \
    echo "${UV_SHA256}  uv.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/uv; tar -xzf uv.tar.gz -C /opt/uv --strip-components=1 --no-same-owner; \
    /opt/uv/uv --version | grep -F "${UV_VERSION}"; \
    mkdir -p /opt/eq-dl; \
    get busybox-rootfs.tar.gz "${BUSYBOX_ROOTFS_URL}"; \
    echo "${BUSYBOX_ROOTFS_SHA256}  busybox-rootfs.tar.gz" | sha256sum -c -; \
    mkdir bb; tar -xzf busybox-rootfs.tar.gz -C bb --no-same-owner --no-same-permissions; \
    echo "${BUSYBOX_SHA256}  bb/bin/busybox" | sha256sum -c -; \
    install -m 0755 bb/bin/busybox /opt/eq-dl/busybox; \
    /opt/eq-dl/busybox | head -n 1; \
    get jq "https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux-arm64"; \
    echo "${JQ_SHA256}  jq" | sha256sum -c -; \
    install -m 0755 jq /opt/eq-dl/jq; \
    [ "$(/opt/eq-dl/jq --version)" = "jq-${JQ_VERSION}" ]; \
    cd /; rm -rf /tmp/dl

# ---------------------------------------------------------------- mathlib: clone the pinned deps, fetch the olean cache
FROM ${BUILDER_IMAGE} AS mathlib
ENV PATH=/opt/lean/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C.UTF-8
COPY --from=fetch /opt/lean /opt/lean
COPY project/ /opt/eq/stack_mathlib/
WORKDIR /opt/eq/stack_mathlib
ARG MATHLIB_REV
RUN set -eux; \
    sha256sum -c SHA256SUMS; \
    grep -F "\"rev\": \"${MATHLIB_REV}\"" lake-manifest.json; \
    grep -Fx 'leanprover/lean4:v4.34.1' lean-toolchain
# Network (build time only): github.com (git clones of the 9 locked packages), the Mathlib cache host
# (lakecache.blob.core.windows.net) and, if the toolchain asks for it, github.com release downloads of leantar.
RUN lake exe cache get
RUN set -eux; \
    printf 'import Mathlib\nexample : (2:Nat) + 2 = 4 := by norm_num\n#eval Lean.versionString\n' > /tmp/smoke.lean; \
    LP=$(lake env printenv LEAN_PATH); echo "LEAN_PATH=$LP"; \
    LEAN_PATH="$LP" lean /tmp/smoke.lean; \
    rm -f /tmp/smoke.lean
RUN set -eux; \
    cd /opt/eq/stack_mathlib/.lake/packages; \
    n=$(find . -name '*.olean' | wc -l); \
    h=$(find . -name '*.olean' | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -d' ' -f1); \
    { echo "lean: $(lean --version)"; \
      echo "mathlib_rev: ${MATHLIB_REV}"; \
      echo "olean_files: $n"; \
      echo "olean_tree_sha256: $h"; \
      echo "olean_tree_recipe: cd .lake/packages && find . -name '*.olean' | LC_ALL=C sort | xargs sha256sum | sha256sum"; \
      echo "project_sha256sums:"; sed 's/^/  /' /opt/eq/stack_mathlib/SHA256SUMS; \
    } > /opt/eq/PROVENANCE.txt; \
    cat /opt/eq/PROVENANCE.txt; \
    rm -rf /root/.cache

# ---------------------------------------------------------------- the real lake's LEAN_PATH, computed once at build time
FROM mathlib AS leanpath
RUN set -eux; cd /opt/eq/stack_mathlib && lake env printenv LEAN_PATH > /opt/eq/LEAN_PATH.real; cat /opt/eq/LEAN_PATH.real

# ---------------------------------------------------------------- static GNU bash from the GPG-signed source (USER decision 1)
# The ONE stage with a package manager: apk (signature-checked by apk, floating within Alpine 3.24), which is why the built
# binary is pinned (BASH_BIN_SHA256). Discarded: only /opt/eq-bash-out/bin/bash leaves it. The build is made reproducible by
# tc/build-bash.sh itself (fixed build path /build, SOURCE_DATE_EPOCH, TZ/LC_ALL, prefix maps, no build-id, make -j1, full strip):
# lib/eq-container/repro-check.sh builds the bash-report stage N times and compares the binaries; pin only after it says
# REPRODUCIBLE. The apk package versions are printed as `DIAG apk` lines and are NOT pinned (a known open source of drift).
FROM ${MUSL_BUILDER_IMAGE} AS bash-builder
RUN apk add --no-cache build-base bison gnupg curl
COPY tc/build-bash.sh /opt/eq-bash/build-bash.sh

FROM bash-builder AS bash
ARG BASH_BASELINE
ARG BASH_PATCHLEVEL
ARG BASH_GPG_FPR
ARG BASH_SRC_SHA256
ARG BASH_PATCHES_SHA256
ARG BASH_BIN_SHA256
RUN sh /opt/eq-bash/build-bash.sh build /opt/eq-bash-out

# build.sh --resolve-tools (with --no-cache): after every signature verifies, `PIN BASH_* <sha256> pinned: same|DIFFERS|PLACEHOLDER`
FROM bash-builder AS bash-report
ARG BASH_BASELINE
ARG BASH_PATCHLEVEL
ARG BASH_GPG_FPR
ARG BASH_SRC_SHA256
ARG BASH_PATCHES_SHA256
ARG BASH_BIN_SHA256
ARG BASH_REPRO_DUMP=0
RUN sh /opt/eq-bash/build-bash.sh resolve /tmp/eq-bash-report

# ---------------------------------------------------------------- prep: everything the assemble stages read
FROM ${BUILDER_IMAGE} AS prep
COPY --from=distroless-cc / /base-rootfs/
COPY --from=fetch /opt/lean /opt/lean
COPY --from=fetch /opt/uv /opt/uv
COPY --from=fetch /opt/python /opt/python
COPY --from=fetch /opt/eq-dl/ /opt/eq-dl/
COPY --from=bash /opt/eq-bash-out/bin/bash /opt/eq-dl/bash
COPY --from=mathlib /opt/eq /opt/eq
COPY --from=leanpath /opt/eq/LEAN_PATH.real /opt/eq/LEAN_PATH.real
COPY minimal/ /opt/eq-min/
# the tools manifest: mkrootfs.sh installs, pins (sha256 / file_sha256) and locks exactly the tools TOOLS.toml lists for the image
COPY TOOLS.toml tools.sh /opt/eq-min/

# Module files kept in the image (KEEP_EXTS): conservative default keeps every kind Lean 4.34's module system writes.
# .olean.private is ~60% of the bytes; whether `lean` reads it at check time is not measured for this backend yet: keep the
# default (profiles: --keep-profile noprivate | slim in build.sh).
FROM prep AS assemble-lean
ARG KEEP_EXTS="olean olean.private olean.server ir ir.sig"
ARG DISTROLESS_CC
ARG DISTROLESS_CC_ARM64
RUN bash /opt/eq-min/mkrootfs.sh lean

FROM prep AS assemble-py
ARG DISTROLESS_CC
ARG DISTROLESS_CC_ARM64
RUN bash /opt/eq-min/mkrootfs.sh py

FROM prep AS assemble-both
ARG KEEP_EXTS="olean olean.private olean.server ir ir.sig"
ARG DISTROLESS_CC
ARG DISTROLESS_CC_ARM64
RUN bash /opt/eq-min/mkrootfs.sh both

# ---------------------------------------------------------------- finals: FROM the pinned distroless cc, one COPY, no RUN
FROM ${DISTROLESS_CC} AS eq-lean-min
COPY --from=assemble-lean /rootfs/ /
ENV PATH=/opt/eq/bin:/opt/lean/bin HOME=/tmp TMPDIR=/tmp LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    EQ_LEAN_PROJECT=/opt/eq/stack_mathlib
LABEL org.opencontainers.image.title="eq-lean-min" \
      org.opencontainers.image.description="Equilibrium PF checks: Lean 4.34.1 + Mathlib v4.34.1 on distroless cc (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/eq/bin/bash"]

FROM ${DISTROLESS_CC} AS eq-py-min
COPY --from=assemble-py /rootfs/ /
ENV PATH=/opt/eq/bin:/opt/uv:/opt/python/bin HOME=/tmp TMPDIR=/tmp LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    UV_PYTHON=/opt/python/bin/python3 UV_PYTHON_DOWNLOADS=never UV_OFFLINE=1 UV_NO_CONFIG=1 UV_NO_PROGRESS=1 \
    UV_CACHE_DIR=/tmp/uv-cache PYTHONDONTWRITEBYTECODE=1
LABEL org.opencontainers.image.title="eq-py-min" \
      org.opencontainers.image.description="Equilibrium CP/CR checks: CPython 3.14.8 + uv on distroless cc (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/eq/bin/bash"]

FROM ${DISTROLESS_CC} AS eq-min
COPY --from=assemble-both /rootfs/ /
ENV PATH=/opt/eq/bin:/opt/lean/bin:/opt/uv:/opt/python/bin HOME=/tmp TMPDIR=/tmp LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    EQ_LEAN_PROJECT=/opt/eq/stack_mathlib \
    UV_PYTHON=/opt/python/bin/python3 UV_PYTHON_DOWNLOADS=never UV_OFFLINE=1 UV_NO_CONFIG=1 UV_NO_PROGRESS=1 \
    UV_CACHE_DIR=/tmp/uv-cache PYTHONDONTWRITEBYTECODE=1
LABEL org.opencontainers.image.title="eq-min" \
      org.opencontainers.image.description="Equilibrium checks, PF CP CR: Lean + Mathlib, CPython + uv on distroless cc (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/eq/bin/bash"]

# ---------------------------------------------------------------- check stages (never exported): the real final filesystem,
# run as the image's user 10001 with busybox sh in exec form (no /bin/sh is assumed); build.sh builds check-<target> first, then
# the target from the same cache, so the image it records is the one that passed.
FROM eq-lean-min AS check-eq-lean-min
COPY minimal/check.sh /opt/eq-check/check.sh
RUN ["/opt/eq/bin/busybox", "sh", "/opt/eq-check/check.sh", "lean"]

FROM eq-py-min AS check-eq-py-min
COPY minimal/check.sh /opt/eq-check/check.sh
RUN ["/opt/eq/bin/busybox", "sh", "/opt/eq-check/check.sh", "py"]

FROM eq-min AS check-eq-min
COPY minimal/check.sh /opt/eq-check/check.sh
RUN ["/opt/eq/bin/busybox", "sh", "/opt/eq-check/check.sh", "both"]
