# Dockerfile.toolchains: the extension images (X3), one per language, opt-in (build.sh --profiles node,go,julia,jvm). NEVER
# BUILT BY ANY AGENT: UNVERIFIED until the first build and verify-tools.sh --images --smoke pass. Bases (USER decision
# 2026-10-06, DESIGN_DISTROLESS.md section 3): node, julia and jvm FROM the pinned distroless cc image (glibc tools: their
# libraries must come from it or from the tool's own tree, never from a third source); go FROM scratch (the Go toolchain is
# built with cgo disabled: every ELF must be static, the build fails otherwise). Rust and Haskell are DEFERRED (their profiles
# have no image and are refused with exit 10: rustc and GHC call a C linker, which no distroless image supplies).
# Every tool, URL, sha256 and prune list comes from ./TOOLS.toml through tc/fetch-tool.sh (sha256 checked BEFORE extraction);
# a PLACEHOLDER stops the build (exit 13) naming the value, so no version or digest is ever guessed here. No stage runs apt,
# dpkg or apk: the builder (buildpack-deps, pinned by digest) already has curl, xz, bzip2 and unzip.
#
# Layout per image (X4 "binary only"): the base, then ONE layer holding the tool tree (/opt/<tool>, pruned of docs, man pages,
# headers, tests), /opt/eq/TOOLS.lock (+ .sha256, IMAGE_KIND, PROVENANCE-tc.txt) and, on scratch, /etc/passwd,group and the
# mount points. No shell, package manager or docs. The per-run copy of the files is mounted at /work and every output goes to the
# capped tmpfs /tmp through the tool's env entries (GOCACHE, JULIA_DEPOT_PATH, ...). These images have no /bin/sh, so the harness's
# COPY_IN prefix cannot be used with them: the day a pool class needs one inside isolate(), that class's image gets the
# /opt/eq/bin toolbox under the same rule as eq-py-min (TOOLS.toml extension procedure).
# check-<target> (built first by build.sh, never exported): the tool's version command in exec form as user 10001, in the real
# final filesystem.

ARG BUILDER_IMAGE=buildpack-deps:trixie@sha256:47fa3fd7df8022082e3f885881775cc7927ec210b470cc4eae9e874f871b008a
ARG DISTROLESS_CC=gcr.io/distroless/cc-debian13@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2
ARG DISTROLESS_CC_ARM64=sha256:2f0295ce228a23109ec1c8d38763bfe995b0dba7b3672f58d3a67ebfbc542fdc

# ---------------------------------------------------------------- the final base, also read by the assemble stages
FROM ${DISTROLESS_CC} AS distroless-cc

FROM ${BUILDER_IMAGE} AS tools-fetch
COPY TOOLS.toml tools.sh /opt/eq-tools/
COPY tc/ /opt/eq-tools/tc/

# ---------------------------------------------------------------- fetch: one stage per tool (pinned archive, sha256 verified first)
FROM tools-fetch AS fetch-node
RUN bash /opt/eq-tools/tc/fetch-tool.sh node
FROM tools-fetch AS fetch-go
RUN bash /opt/eq-tools/tc/fetch-tool.sh go
FROM tools-fetch AS fetch-julia
RUN bash /opt/eq-tools/tc/fetch-tool.sh julia
FROM tools-fetch AS fetch-jdk
RUN bash /opt/eq-tools/tc/fetch-tool.sh jdk
FROM tools-fetch AS fetch-scala3
RUN bash /opt/eq-tools/tc/fetch-tool.sh scala3

# ---------------------------------------------------------------- per-image assemble stages (layer = the tool tree + the lock)
FROM tools-fetch AS assemble-node
ARG DISTROLESS_CC
ARG DISTROLESS_CC_ARM64
COPY --from=distroless-cc / /base-rootfs/
COPY --from=fetch-node /opt/node /opt/node
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh tc-node

FROM tools-fetch AS assemble-go
COPY --from=fetch-go /opt/go /opt/go
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh tc-go

FROM tools-fetch AS assemble-julia
ARG DISTROLESS_CC
ARG DISTROLESS_CC_ARM64
COPY --from=distroless-cc / /base-rootfs/
COPY --from=fetch-julia /opt/julia /opt/julia
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh tc-julia

FROM tools-fetch AS assemble-jvm
ARG DISTROLESS_CC
ARG DISTROLESS_CC_ARM64
COPY --from=distroless-cc / /base-rootfs/
COPY --from=fetch-jdk /opt/jdk /opt/jdk
COPY --from=fetch-scala3 /opt/scala3 /opt/scala3
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh tc-jvm

# ---------------------------------------------------------------- finals: one COPY, no RUN (ENV mirrors TOOLS.toml bins/env)
FROM ${DISTROLESS_CC} AS eq-node
COPY --from=assemble-node /rootfs/ /
ENV PATH=/opt/node/bin LANG=C.UTF-8 HOME=/tmp TMPDIR=/tmp
LABEL org.opencontainers.image.title="eq-node" org.opencontainers.image.description="Equilibrium extension: Node.js on distroless cc, no shell (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/node/bin/node", "--version"]

FROM scratch AS eq-go
COPY --from=assemble-go /rootfs/ /
ENV PATH=/opt/go/bin LANG=C.UTF-8 HOME=/tmp TMPDIR=/tmp GOROOT=/opt/go GOFLAGS=-mod=mod CGO_ENABLED=0 GOCACHE=/tmp/go-cache GOPATH=/tmp/go GOTOOLCHAIN=local GOPROXY=off
LABEL org.opencontainers.image.title="eq-go" org.opencontainers.image.description="Equilibrium extension: Go FROM scratch, static, no shell (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/go/bin/go", "version"]

FROM ${DISTROLESS_CC} AS eq-julia
COPY --from=assemble-julia /rootfs/ /
ENV PATH=/opt/julia/bin LANG=C.UTF-8 HOME=/tmp TMPDIR=/tmp JULIA_DEPOT_PATH=/tmp/julia JULIA_PKG_OFFLINE=true
LABEL org.opencontainers.image.title="eq-julia" org.opencontainers.image.description="Equilibrium extension: Julia on distroless cc, no shell (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/julia/bin/julia", "--version"]

FROM ${DISTROLESS_CC} AS eq-jvm
COPY --from=assemble-jvm /rootfs/ /
ENV PATH=/opt/jdk/bin:/opt/scala3/bin LANG=C.UTF-8 HOME=/tmp TMPDIR=/tmp JAVA_HOME=/opt/jdk
LABEL org.opencontainers.image.title="eq-jvm" org.opencontainers.image.description="Equilibrium extension: one JDK shared by Java and Scala 3 on distroless cc, no shell (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/jdk/bin/java", "-version"]

# ---------------------------------------------------------------- check stages (never exported): exec form, user 10001
FROM eq-node AS check-eq-node
RUN ["/opt/node/bin/node", "--version"]

FROM eq-go AS check-eq-go
RUN ["/opt/go/bin/go", "version"]

FROM eq-julia AS check-eq-julia
RUN ["/opt/julia/bin/julia", "--version"]

FROM eq-jvm AS check-eq-jvm
RUN ["/opt/jdk/bin/java", "-version"]
