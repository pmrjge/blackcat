# Dockerfile.toolchains: the extension images (X3): per-language toolchains, all FROM the shared minimal base `eq-base` (glibc
# closure + /etc/passwd,group, no shell, no tools). Built by bash build.sh --profiles node,rust,go,julia,haskell,jvm (or one
# target: container build --target eq-go ...). NEVER BUILT BY ANY AGENT: UNVERIFIED until the first build and
# verify-tools.sh --images --smoke pass. The database images (PostgreSQL, MongoDB) were dropped with compose (their only runner;
# MongoDB OUT by the USER's decision of 2026-10-05). Every tool, URL, sha256 and prune list comes from ./TOOLS.toml through tc/fetch-tool.sh; a PLACEHOLDER
# in an entry stops the build (exit 13) with the name of the value, so no version or digest is ever guessed here.
#
# Layout per image (X4 "binary only"): FROM eq-base, then ONE layer holding the tool tree (/opt/<tool>, pruned of docs, man pages,
# headers, tests), the shared libraries the base does not hold, /opt/eq/TOOLS.lock. No shell, package manager or docs. The Rust and
# Haskell images also carry a cc linker driver (USER decision 2026-10-05, conflict C6): the Debian gcc + libc6-dev package closure
# (and libgmp-dev, libffi-dev for GHC) from the pinned snapshot, recorded by tc/apt-closure.sh and copied by mkrootfs-tc.sh.
# Builder stages (apt, curl, compilers) are discarded; apt reads the same Debian snapshot as Dockerfile.minimal. The first stages
# are byte-identical to Dockerfile.minimal's `base`, so the pins are the same (build.sh --check compares PINS and the ARGs).
#
# Work dir design: the per-run copy of the files is mounted READ-ONLY at /work (container run --mount ...,readonly), and every
# output goes to the capped tmpfs /tmp through the env entries of the tool (GOCACHE, CARGO_TARGET_DIR, JULIA_DEPOT_PATH, ...). These
# images have no /bin/sh, so the COPY_IN prefix of the harness cannot be used with them: the day a pool class needs one of them
# inside harness isolate(), that class's image gets busybox sh + cp under the same rule as eq-py-min (TOOLS.toml extension procedure).
#
# Scratch vs distroless (decision rule, INSTALLER_SPEC.md section 12.4): every final image here is scratch-based (eq-base): the
# runtime closure is copied with ldd and checked with ld.so --list. The distroless alternative only wins for a tool that dlopens
# something ldd cannot see (tzdata, NSS modules, a CA bundle) AND whose measured size/smoke result is no worse.

ARG BASE_IMAGE=debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

# ---------------------------------------------------------------- base: apt pinned by snapshot date (builder only)
FROM ${BASE_IMAGE} AS base
ARG APT_SNAPSHOT=20260918T000000Z
ENV DEBIAN_FRONTEND=noninteractive
RUN set -eu; \
    if [ -n "${APT_SNAPSHOT}" ]; then \
      rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; \
      echo "deb http://snapshot.debian.org/archive/debian/${APT_SNAPSHOT}/ trixie main" > /etc/apt/sources.list; \
      echo 'Acquire::Check-Valid-Until "false"; Acquire::Retries "5";' > /etc/apt/apt.conf.d/99snapshot; \
    fi

FROM base AS tools-fetch
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl xz-utils zstd unzip bzip2 \
 && rm -rf /var/lib/apt/lists/*
COPY TOOLS.toml tools.sh /opt/eq-tools/
COPY tc/ /opt/eq-tools/tc/

# compilers exist only here (a tool whose provenance is built-from-source); never copied to a final image
FROM tools-fetch AS tools-build
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential bison flex perl \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------- fetch: one stage per tool (pinned archive, sha256 verified first)
FROM tools-fetch AS fetch-node
RUN bash /opt/eq-tools/tc/fetch-tool.sh node
FROM tools-fetch AS fetch-rust
RUN bash /opt/eq-tools/tc/fetch-tool.sh rust
FROM tools-fetch AS fetch-go
RUN bash /opt/eq-tools/tc/fetch-tool.sh go
FROM tools-fetch AS fetch-julia
RUN bash /opt/eq-tools/tc/fetch-tool.sh julia
FROM tools-build AS fetch-ghc
RUN bash /opt/eq-tools/tc/fetch-tool.sh ghc
FROM tools-fetch AS fetch-cabal
RUN bash /opt/eq-tools/tc/fetch-tool.sh cabal
FROM tools-fetch AS fetch-jdk
RUN bash /opt/eq-tools/tc/fetch-tool.sh jdk
FROM tools-fetch AS fetch-scala3
RUN bash /opt/eq-tools/tc/fetch-tool.sh scala3
# ---------------------------------------------------------------- diagnostic: version + sha256 of the distro-package tools (cc,
# ghc-link-libs) for `build.sh --resolve-tools [--write-pin]` (trust on first use: review the printed package versions)
FROM base AS tc-tools-report
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev libgmp-dev libffi-dev \
 && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    rep() { echo "TOOL $1 $(dpkg-query -W -f='${Version}' "$2") $(sha256sum "$(readlink -f "$3")" | cut -d' ' -f1)"; }; \
    rep cc gcc /usr/bin/aarch64-linux-gnu-gcc-14; rep ghc-link-libs libgmp-dev /usr/lib/aarch64-linux-gnu/libgmp.so

# ---------------------------------------------------------------- the shared minimal base
FROM base AS prep
RUN apt-get update \
 && apt-get install -y --no-install-recommends libstdc++6 \
 && rm -rf /var/lib/apt/lists/*
COPY TOOLS.toml tools.sh /opt/eq-tools/
COPY tc/ /opt/eq-tools/tc/

FROM prep AS assemble-base
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh base

FROM scratch AS eq-base
COPY --from=assemble-base /rootfs/ /
LABEL org.opencontainers.image.title="eq-base" \
      org.opencontainers.image.description="Equilibrium shared minimal base: glibc closure and /etc/passwd,group only (arm64)"

# ---------------------------------------------------------------- per-image assemble stages (layer = what eq-base does not hold)
FROM prep AS assemble-node
COPY --from=assemble-base /rootfs/ /base-rootfs/
COPY --from=fetch-node /opt/node /opt/node
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh tc-node

FROM prep AS assemble-rust
# the cc linker rustc calls (tool cc): the package closure this install adds is recorded for mkrootfs-tc.sh
RUN bash /opt/eq-tools/tc/apt-closure.sh cc gcc libc6-dev
COPY --from=assemble-base /rootfs/ /base-rootfs/
COPY --from=fetch-rust /opt/rust /opt/rust
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh tc-rust

FROM prep AS assemble-go
COPY --from=assemble-base /rootfs/ /base-rootfs/
COPY --from=fetch-go /opt/go /opt/go
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh tc-go

FROM prep AS assemble-julia
COPY --from=assemble-base /rootfs/ /base-rootfs/
COPY --from=fetch-julia /opt/julia /opt/julia
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh tc-julia

FROM prep AS assemble-haskell
# builder-side libraries only so that ldd can resolve (and mkrootfs-tc.sh copy) the GHC runtime closure; names from the GHCup system
# requirements for Debian 13 (TOOLCHAINS.md). An unresolved library still fails the build with its name (UNVERIFIED until a build passes).
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgmp10 libffi8 libncurses6 libtinfo6 \
 && rm -rf /var/lib/apt/lists/*
# the cc linker GHC calls (tool cc) and the libraries it links programs against (tool ghc-link-libs)
RUN bash /opt/eq-tools/tc/apt-closure.sh cc gcc libc6-dev \
 && bash /opt/eq-tools/tc/apt-closure.sh ghc-link-libs libgmp-dev libffi-dev
COPY --from=assemble-base /rootfs/ /base-rootfs/
COPY --from=fetch-ghc /opt/ghc /opt/ghc
COPY --from=fetch-cabal /opt/cabal /opt/cabal
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh tc-haskell

FROM prep AS assemble-jvm
# builder-side zlib for ldd (Temurin may link the system zlib: unverified); the AWT/X11 libraries are pruned in TOOLS.toml instead
RUN apt-get update \
 && apt-get install -y --no-install-recommends zlib1g \
 && rm -rf /var/lib/apt/lists/*
COPY --from=assemble-base /rootfs/ /base-rootfs/
COPY --from=fetch-jdk /opt/jdk /opt/jdk
COPY --from=fetch-scala3 /opt/scala3 /opt/scala3
RUN bash /opt/eq-tools/tc/mkrootfs-tc.sh tc-jvm

# ---------------------------------------------------------------- finals: FROM eq-base (ENV mirrors TOOLS.toml bins/env; a test compares them)
FROM eq-base AS eq-node
COPY --from=assemble-node /rootfs/ /
ENV PATH=/opt/node/bin LANG=C.UTF-8 HOME=/tmp TMPDIR=/tmp
LABEL org.opencontainers.image.title="eq-node" org.opencontainers.image.description="Equilibrium extension: Node.js, no shell (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/node/bin/node", "--version"]

FROM eq-base AS eq-rust
COPY --from=assemble-rust /rootfs/ /
ENV PATH=/opt/rust/bin:/usr/bin LANG=C.UTF-8 HOME=/tmp TMPDIR=/tmp CARGO_HOME=/tmp/cargo CARGO_TARGET_DIR=/tmp/target
LABEL org.opencontainers.image.title="eq-rust" org.opencontainers.image.description="Equilibrium extension: Rust + cc linker, no shell (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/rust/bin/rustc", "--version"]

FROM eq-base AS eq-go
COPY --from=assemble-go /rootfs/ /
ENV PATH=/opt/go/bin LANG=C.UTF-8 HOME=/tmp TMPDIR=/tmp GOROOT=/opt/go GOFLAGS=-mod=mod CGO_ENABLED=0 GOCACHE=/tmp/go-cache GOPATH=/tmp/go GOTOOLCHAIN=local GOPROXY=off
LABEL org.opencontainers.image.title="eq-go" org.opencontainers.image.description="Equilibrium extension: Go, no shell (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/go/bin/go", "version"]

FROM eq-base AS eq-julia
COPY --from=assemble-julia /rootfs/ /
ENV PATH=/opt/julia/bin LANG=C.UTF-8 HOME=/tmp TMPDIR=/tmp JULIA_DEPOT_PATH=/tmp/julia JULIA_PKG_OFFLINE=true
LABEL org.opencontainers.image.title="eq-julia" org.opencontainers.image.description="Equilibrium extension: Julia, no shell (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/julia/bin/julia", "--version"]

FROM eq-base AS eq-haskell
COPY --from=assemble-haskell /rootfs/ /
ENV PATH=/opt/ghc/bin:/opt/cabal:/usr/bin LANG=C.UTF-8 HOME=/tmp TMPDIR=/tmp CABAL_DIR=/tmp/cabal
LABEL org.opencontainers.image.title="eq-haskell" org.opencontainers.image.description="Equilibrium extension: GHC, cabal + cc linker, no shell (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/ghc/bin/ghc", "--version"]

FROM eq-base AS eq-jvm
COPY --from=assemble-jvm /rootfs/ /
ENV PATH=/opt/jdk/bin:/opt/scala3/bin LANG=C.UTF-8 HOME=/tmp TMPDIR=/tmp JAVA_HOME=/opt/jdk
LABEL org.opencontainers.image.title="eq-jvm" org.opencontainers.image.description="Equilibrium extension: one JDK shared by Java and Scala 3, no shell (arm64)"
USER 10001:10001
WORKDIR /work
CMD ["/opt/jdk/bin/java", "-version"]
