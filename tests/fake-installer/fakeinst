#!/usr/bin/python3 -IB
"""Fake brew / uv / npm / pnpm / cargo / go for tests/test_toolsmith.py: never installs anything.

Copied into a test's bin dir under each installer's name. State lives beside the copy:
  calls.jsonl         one line per call: {"prog", "argv", "cwd", "env"} (the whole environment)
  installed/<prog>-<name>   the "installed" packages (file content: the version)
  fail                when present, every install/uninstall exits 1
  uv-bins-<name>      for uv: extra console-script names its install links into uvbin/ (comma list)
  nohelp              when present, `npm install --help` fails (no --allow-* flags seen)
Answers the read-only queries bin/stack-install makes (brew list --versions, uv tool list, npm/pnpm ls
--global --json, cargo install --list, go env GOBIN GOPATH, npm install --help).
"""
import json
import os
import re
import sys

here = os.path.dirname(os.path.abspath(sys.argv[0]))
prog = os.path.basename(sys.argv[0])
args = sys.argv[1:]
inst = os.path.join(here, "installed")
os.makedirs(inst, exist_ok=True)
with open(os.path.join(here, "calls.jsonl"), "a") as f:
    f.write(json.dumps({"prog": prog, "argv": args, "cwd": os.getcwd(), "env": dict(os.environ)}) + "\n")


def have(name):
    p = os.path.join(inst, "%s-%s" % (prog, name.replace("/", "%")))
    return open(p).read().strip() if os.path.isfile(p) else None


def put(name, version):
    if os.path.exists(os.path.join(here, "fail")):
        sys.stderr.write("fake %s: failing on purpose\n" % prog)
        sys.exit(1)
    with open(os.path.join(inst, "%s-%s" % (prog, name.replace("/", "%"))), "w") as f:
        f.write(version)


def drop(name):
    if os.path.exists(os.path.join(here, "fail")):
        sys.exit(1)
    p = os.path.join(inst, "%s-%s" % (prog, name.replace("/", "%")))
    if not os.path.isfile(p):
        sys.exit(1)
    os.unlink(p)


def all_of():
    for f in sorted(os.listdir(inst)):
        if f.startswith(prog + "-"):
            yield f[len(prog) + 1:].replace("%", "/"), open(os.path.join(inst, f)).read().strip()


pos = [a for a in args if not a.startswith("-")]
if prog == "brew":
    if args[:1] == ["list"]:
        v = have(pos[-1])
        if v:
            print("%s %s" % (pos[-1], v))
            sys.exit(0)
        sys.exit(1)
    if args[:1] in (["install"], ["upgrade"]):
        put(pos[-1], os.environ.get("FAKE_VERSION") or "1.8.2")
    elif args[:1] == ["uninstall"]:
        drop(pos[-1])
    elif args[:1] == ["--version"]:
        print("Homebrew 7.0.8 (fake)")
elif prog == "uv":
    uvbin = os.path.join(here, "uvbin")
    if args[:2] == ["tool", "list"]:              # uv prints the normalized name
        for n, v in all_of():
            print("%s v%s" % (re.sub(r"[-_.]+", "-", n).lower(), v))
            print("- %s" % n)
    elif args[:2] == ["tool", "dir"]:
        print(uvbin)
    elif args[:2] == ["tool", "install"]:
        n, v = pos[-1].split("==")
        put(n, v)
        os.makedirs(uvbin, exist_ok=True)
        extra = os.path.join(here, "uv-bins-" + n)
        names = [n] + (open(extra).read().strip().split(",") if os.path.isfile(extra) else [])
        for b in names:
            with open(os.path.join(uvbin, b), "w") as f:
                f.write("#!/bin/sh\n")
    elif args[:2] == ["tool", "uninstall"]:
        drop(pos[-1])
        extra = os.path.join(here, "uv-bins-" + pos[-1])
        for b in [pos[-1]] + (open(extra).read().strip().split(",") if os.path.isfile(extra) else []):
            if os.path.exists(os.path.join(uvbin, b)):
                os.unlink(os.path.join(uvbin, b))
elif prog in ("npm", "pnpm"):
    if args[:1] == ["ls"]:
        doc = {"dependencies": {n: {"version": v} for n, v in all_of()}}
        print(json.dumps([doc] if prog == "pnpm" else doc))
    elif args[:2] == ["install", "--help"]:
        if os.path.exists(os.path.join(here, "nohelp")):
            sys.exit(1)
        print("[--allow-directory <all|none|root>] [--allow-file <all|none|root>] [--allow-git <all|none|root>]")
        print("[--allow-remote <all|none|root>]")
    elif args[:1] in (["install"], ["add"]):
        spec = pos[-1]
        n, v = spec.rsplit("@", 1)
        put(n, v)
    elif args[:1] in (["uninstall"], ["remove"]):
        drop(pos[-1])
elif prog == "cargo":
    if args[:2] == ["install", "--list"]:
        for n, v in all_of():
            print("%s v%s:" % (n, v))
            print("    %s" % n)
    elif args[:1] == ["install"]:
        n, v = pos[-1].split("@")
        put(n, v)
    elif args[:1] == ["uninstall"]:
        drop(pos[-1])
elif prog == "go":
    gobin = os.path.join(here, "gobin")
    if args[:1] == ["env"]:
        print(gobin)
        print(os.path.join(here, "gopath"))
    elif args[:1] == ["install"]:
        path = pos[-1].split("@")[0]
        elems = path.split("/")
        name = elems[-2] if re.match(r"v\d+\Z", elems[-1]) and len(elems) > 2 else elems[-1]
        if os.path.exists(os.path.join(here, "fail")):
            sys.exit(1)
        os.makedirs(gobin, exist_ok=True)
        with open(os.path.join(gobin, name), "w") as f:
            f.write("#!/bin/sh\n")
    elif args[:1] == ["version"]:
        print("go version go1.27.1 fake")
else:
    if os.path.exists(os.path.join(here, "fail")):
        sys.exit(1)
sys.exit(0)
