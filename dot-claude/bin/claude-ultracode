#!/bin/sh
# claude-agent-stack: ninja-coder or supreme-coder as the MAIN THREAD at ultracode — xhigh effort plus
# dynamic workflows, with workflow launches pre-approved in these sessions only.
#   claude-ninja [claude args…]     claude-supreme [claude args…]     claude-ultracode <agent> [claude args…]
# Ultracode exists only on a main thread. An agent file's `effort` applies to subagents only, and
# `effort: ultracode` there is ignored (the agent would run at the calling session's level), so
# dispatched by BlackCat these agents run at max; started from here they run at ultracode.
case "$(basename "$0")" in
  claude-ninja) agent=ninja-coder ;;
  claude-supreme) agent=supreme-coder ;;
  *)
    if [ $# -eq 0 ]; then
      echo "usage: claude-ultracode <agent> [claude args…]   (or: claude-ninja, claude-supreme)" >&2
      exit 2
    fi
    agent=$1
    shift ;;
esac
# Forge tokens stay out of the session (C6): agents never push or write to a forge, and a token in
# the environment would reach every subprocess an agent starts. gh's own login (gh auth) still
# answers reads.
exec env -u GITHUB_TOKEN -u GH_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN \
  -u GITLAB_TOKEN -u GITEA_TOKEN -u FORGEJO_TOKEN -u CODEBERG_TOKEN \
  claude --agent "$agent" --effort ultracode --settings '{"permissions":{"allow":["Workflow"]}}' "$@"
