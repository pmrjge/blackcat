   "claude-sonnet-4-6"
  ],
  "alias_defaults": {
   "_note": "Used only when ANTHROPIC_DEFAULT_<ALIAS>_MODEL is unset (install.sh sets opus and sonnet from stack.env); fable has no stack.env line, so this is Claude Code 2.1.287's own fable default.",
   "fable": "claude-fable-5-1"
  }
