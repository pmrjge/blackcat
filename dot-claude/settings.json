{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "blackcat",
  "autoCompactEnabled": true,
  "autoCompactWindow": 400000,
  "skillListingBudgetFraction": 0.012,
  "skillListingMaxDescChars": 500,
