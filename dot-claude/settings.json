  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/claude-sandbox"
      ],
      "denyWrite": [
        "__CLAUDE_DIR__",
        "__STACK_STATE__",
        "__STACK_BACKUPS__",
        "__STACK_CACHE__",
        "~/.cache/uv",
        "~/.cache/pre-commit",
        "~/.cache/ms-playwright",
        "~/Library/Caches/ms-playwright",
        "~/Library/Caches/Coursier",
        "~/.cache/huggingface/token"
      ],
      "denyRead": [
        "__CLAUDE_DIR__/**/stack.env",
        "__CLAUDE_DIR__/backup-*",
        "__STACK_BACKUPS__",
        "__CLAUDE_DIR__/.credentials.json",
        "~/.config/gh/hosts.yml",
        "~/.git-credentials",
        "~/.config/git/credentials"
      ]
    },
    "network": {
      "strictAllowlist": true,
      "allowLocalBinding": true,
