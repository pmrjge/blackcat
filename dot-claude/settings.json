{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "blackcat",
  "autoCompactEnabled": true,
  "autoCompactWindow": 400000,
  "skillListingBudgetFraction": 0.012,
  "skillListingMaxDescChars": 500,
  "skillOverrides": {
    "code-review": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "init": "user-invocable-only"
  },
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "4",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "32",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "400",
    "MCP_DISCOVERY_CACHE": "1",
    "MCP_DISCOVERY_CACHE_TTL_S": "21600",
    "MCP_DISCOVERY_CACHE_MAX_STALE_S": "604800",
    "MCP_TIMEOUT": "60000",
    "MAX_MCP_OUTPUT_TOKENS": "25000",
    "BLACKCAT_MAX_STEPS": "12",
    "BLACKCAT_MAX_DISPATCH": "8",
    "BLACKCAT_DISPATCH_WINDOW_S": "120",
    "STACK_MAX_FANOUT": "3",
    "STACK_MAX_FANOUT_BY_TYPE": "orchestrator=10,god-coder=6,main-coder=6,ninja-coder=5,researcher=4,planner=8,plan-reviewer=8",
    "STACK_MAX_SELF_FANOUT": "2",
    "STACK_PROMPT_CTX_BUDGET": "100000000",
    "STACK_SESSION_CTX_BUDGET": "666000000",
    "STACK_MAX_MCP_CALLS": "64",
    "STACK_ENV_FILE": "__CLAUDE_DIR__/stack.env",
    "STACK_FANOUT_IDLE_S": "600",
    "GOD_IDLE_S": "1800",
    "UV_CACHE_DIR": "__HOME__/.cache/claude-sandbox/uv",
    "npm_config_cache": "__HOME__/.cache/claude-sandbox/npm",
    "PRE_COMMIT_HOME": "__HOME__/.cache/claude-sandbox/pre-commit",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "credential.helper",
    "GIT_CONFIG_VALUE_0": ""
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "ask": [
      "mcp__magg__magg_add_server",
      "mcp__magg__magg_load_kit",
      "mcp__magg__proxy",
      "mcp__magg__magg_enable_server",
      "mcp__magg__duckdb_*",
      "mcp__magg__jupyter_*",
      "mcp__magg__ros_*",
      "mcp__magg__qiskit_*",
      "mcp__magg__docspace_*",
      "CronCreate",
      "RemoteTrigger"
    ],
    "allow": [
      "WebSearch",
      "WebFetch",
      "mcp__exa",
      "mcp__jina",
      "mcp__libdocs",
      "mcp__wolfram",
      "mcp__huggingface",
      "mcp__wandb",
      "mcp__spider",
      "mcp__image-studio",
      "mcp__huetension",
      "mcp__markitdown",
      "mcp__illustrator",
      "mcp__after-effects",
      "mcp__premiere",
      "mcp__blender",
      "mcp__magg__magg_list_servers",
      "mcp__magg__magg_list_kits",
      "mcp__magg__magg_kit_info",
      "mcp__magg__magg_search_servers",
      "mcp__magg__magg_status",
      "mcp__magg__magg_check",
      "mcp__magg__magg_disable_server",
      "mcp__magg__magg_unload_kit",
      "mcp__magg__magg_reload_config",
      "mcp__magg__docling_*",
      "mcp__magg__pw_*",
      "mcp__magg__lean_*",
      "mcp__magg__arxiv_*",
      "mcp__magg__mlflow_*",
      "mcp__magg__mongodb_*",
      "mcp__magg__postgres_*",
      "mcp__magg__cdt_*",
      "mcp__playwright",
      "mcp__neural-memory",
      "mcp__context-mode__ctx_fetch_and_index",
      "mcp__context-mode__ctx_index",
      "mcp__context-mode__ctx_search",
      "mcp__context-mode__ctx_stats",
      "Skill"
    ],
    "deny": [
      "Agent(blackcat)",
      "Bash(git push *)",
      "Bash(git send-pack *)",
      "Bash(git lfs push *)",
      "Bash(git subtree push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr new *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh release create *)",
      "Bash(gh release new *)",
      "Bash(gh release upload *)",
      "Bash(gh repo create *)",
      "Bash(gh repo fork *)",
      "Bash(gh repo sync *)",
      "Bash(gh workflow run *)",
      "Bash(tea pulls create *)",
      "Bash(tea pulls merge *)",
      "Bash(tea pr create *)",
      "Bash(tea pr merge *)",
      "Bash(tea releases create *)",
      "Bash(tea release create *)",
      "Bash(fj pr create *)",
      "Bash(fj pr merge *)",
      "Bash(fj release create *)",
      "Bash(fj repo create *)",
      "Bash(mcp-headers *--reveal*)",
      "Bash(with-stack-env *--reveal*)",
      "Bash(bash -x install.sh)",
      "Bash(bash -x doctor.sh)",
      "Bash(sh -x install.sh)",
      "Bash(sh -x doctor.sh)",
      "Bash(zsh -x install.sh)",
      "Bash(zsh -x doctor.sh)",
      "Read(/__CLAUDE_DIR__/stack.env)",
      "Read(/__CLAUDE_DIR__/**/stack.env)",
      "Read(/__CLAUDE_DIR__/backup-*/**)",
      "Read(/__STACK_BACKUPS__/**)",
      "Read(/__CLAUDE_DIR__/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(/__CLAUDE_DIR__/.claude.json)",
      "Edit(/__CLAUDE_DIR__/hooks/**)",
      "Edit(/__CLAUDE_DIR__/settings.json)",
      "Edit(/__CLAUDE_DIR__/bin/**)",
      "Edit(/__CLAUDE_DIR__/stack-plugins/**)",
      "Edit(/__CLAUDE_DIR__/agents/**)",
      "Edit(/__CLAUDE_DIR__/rules/**)",
      "Edit(/__CLAUDE_DIR__/mcp/**)",
      "Edit(/__CLAUDE_DIR__/magg/**)",
      "Edit(/__CLAUDE_DIR__/skills/**)",
      "Edit(/__CLAUDE_DIR__/CLAUDE.md)",
      "Edit(/__CLAUDE_DIR__/backup-*/**)",
      "Edit(/__STACK_BACKUPS__/**)",
      "Edit(/__CLAUDE_DIR__/.stack-manifest.json)",
      "Edit(.git/hooks/**)",
      "Edit(.git/config)",
      "Edit(.git/config.worktree)",
      "Edit(.git/modules/**/hooks/**)",
      "Edit(.git/modules/**/config)",
      "Edit(.git/worktrees/*/config.worktree)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.cache/huggingface/token)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/Library/Keychains/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.stage)",
      "Read(**/.env.staging)",
      "Edit(~/.local/state/claude-agent-stack/**)",
      "mcp__context-mode__ctx_execute",
      "mcp__context-mode__ctx_execute_file",
      "mcp__context-mode__ctx_batch_execute",
      "mcp__context-mode__ctx_upgrade",
      "mcp__context-mode__ctx_purge",
      "mcp__context-mode__ctx_insight"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/Library/Caches",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/go/pkg",
        "~/.gradle/caches",
        "~/.m2/repository",
        "~/.bun/install/cache",
        "~/.matplotlib"
      ],
      "denyWrite": [
        "__CLAUDE_DIR__",
        "~/.local/state/claude-agent-stack",
        "__STACK_BACKUPS__",
        "__STACK_CACHE__",
        "~/.cache/uv",
        "~/.cache/pre-commit",
        "~/.cache/ms-playwright",
        "~/Library/Caches/ms-playwright",
        "~/.cache/huggingface/token"
      ],
      "denyRead": [
        "__CLAUDE_DIR__/**/stack.env",
        "__CLAUDE_DIR__/backup-*",
        "__STACK_BACKUPS__",
        "__CLAUDE_DIR__/.credentials.json",
        "~/.config/gh/hosts.yml",
        "~/.git-credentials"
      ]
    },
    "network": {
      "strictAllowlist": true,
      "allowLocalBinding": true,
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "[::1]",
        "pypi.org",
        "files.pythonhosted.org",
        "download.pytorch.org",
        "astral.sh",
        "releases.astral.sh",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "repo.yarnpkg.com",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "ghcr.io",
        "gitlab.com",
        "codeberg.org",
        "bitbucket.org",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "static.rust-lang.org",
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com",
        "huggingface.co",
        "*.huggingface.co",
        "*.hf.co",
        "pkg.julialang.org",
        "*.pkg.julialang.org",
        "julialang-s3.julialang.org",
        "releases.lean-lang.org",
        "*.lean-lang.org",
        "formulae.brew.sh",
        "cdn.jsdelivr.net",
        "unpkg.com",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "api.wandb.ai",
        "arxiv.org",
        "export.arxiv.org"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_ENTERPRISE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_ENTERPRISE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITLAB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITEA_TOKEN",
          "mode": "deny"
        },
        {
          "name": "FORGEJO_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CODEBERG_TOKEN",
          "mode": "deny"
        },
        {
          "name": "HF_TOKEN",
          "mode": "deny"
        },
        {
          "name": "HUGGING_FACE_HUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "WANDB_API_KEY",
          "mode": "deny"
        },
        {
          "name": "JUPYTER_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\" no-push",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__computer-use__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__context-mode__ctx_index|mcp__markitdown__.*|mcp__magg__docling_.*|mcp__playwright__.*|mcp__magg__pw_.*|mcp__magg__cdt_.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__neural-memory__nmem_remember",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\" image-limit",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\" blackcat-guard --settings",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\" budget",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\" image-limit",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/hooks/agent_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"__PYTHON3__\" \"__CLAUDE_DIR__/bin/statusline.py\"",
    "refreshInterval": 15
  }
}
